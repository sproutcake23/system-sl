# ══════════════════════════════════════════════════════════════════════════════
# SYSTEM-SL PROJECT GITIGNORE
# ══════════════════════════════════════════════════════════════════════════════

# Environments & Dependencies
.venv/
myenv/
node_modules/
# Python Build & Distribution Artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
build/
dist/
system_sl.egg-info/
*.spec

# Local Environment Variables & Secrets (CRITICAL)
.env
.env.local
credentials.json
token.json
# App OAuth client, written by the release workflow from a repository secret
src/system_sl/assets/google_oauth_client.json

# Persistent Application Data / Runtime Caches
# (Keeps your user profiles, task logs, and vector caches out of Git)
data/
.data/
vector_cache.json
persona.json
completed_tasks.json

# IDE Configurations
.idea/
.vscode/
*.swp

# Agent Instructions (personal, kept local)
# Machine-wide prefs live in ~/.agents/AGENTS.md. These stay untracked so
# personal working rules are not published in the shared repository.
AGENTS.md
CLAUDE.md

