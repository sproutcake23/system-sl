  <name>System-SL</name>
  <summary>Gamified task manager with an AI mentor</summary>

  <developer id="io.github.sproutcake23">
    <name>sproutcake23</name>
  </developer>

  <description>
    <p>
      System-SL is a personal progression system inspired by Solo Leveling.
      You define your daily quests, and the SYSTEM keeps you on track from
      your desktop.
    </p>
    <ul>
      <li>Add, edit, complete and reorder quests with deadlines</li>
      <li>A priority engine that ranks what to work on next</li>
      <li>An AI mentor to chat with, using Gemini, Ollama, LM Studio, OpenRouter or any OpenAI-compatible endpoint</li>
      <li>Pull tasks out of attached PDF, DOCX, HTML or text files</li>
      <li>Google Tasks sync and desktop notifications</li>
      <li>Themes that follow your wallpaper</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.sproutcake23.system_sl.desktop</launchable>

